# 环境变量（含密钥，切勿提交）
.env
.env.local
.env.example

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# 旧开发数据目录（会话/上传等已统一迁至用户目录 ~/.code-agent，勿提交项目内残留）
server/data
server/.uploads

# Electron 开发模式后端动态端口记录（运行时生成）
.api-port

# electron-vite 启动时生成的配置副本（每次 dev 会重写，不要提交）
electron.vite.config.*.mjs

# Electron 打包产物（release / release_build 目录由 electron-builder 生成）
release
release_build
release-*

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.ps1

# LangGraph API
.langgraph_api
